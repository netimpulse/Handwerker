{% comment %}
  Enhanced Blog Post Section - Craftsman Theme
  Rich blog article display with video embeds, animated elements, charts,
  table of contents, progress bar, author box, share buttons, related posts.
  Features: Inline block positioning, block size/alignment control, optional author image
  Uses Shopify's native article object - every blog post appears automatically.
  Features: Structured data (JSON-LD), breadcrumbs, prev/next navigation.
{% endcomment %}

{%- assign current_article = article -%}

<blog-post-enhanced class="color-{{ section.settings.color_scheme }}">
  {%- if current_article != blank -%}
    {%- assign word_count = current_article.content | strip_html | split: ' ' | size -%}
    {%- assign read_time = word_count | divided_by: 200 | at_least: 1 -%}

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": {{ current_article.title | json }},
        "description": {{ current_article.excerpt_or_content | strip_html | truncatewords: 30 | json }},
        "image": {% if current_article.image %}"{{ current_article.image | image_url: width: 1200 }}"{% else %}""{% endif %},
        "datePublished": "{{ current_article.published_at | date: '%Y-%m-%d' }}",
        "dateModified": "{{ current_article.updated_at | date: '%Y-%m-%d' }}",
        "author": {
          "@type": "Person",
          "name": "{{ current_article.author | escape }}"
        },
        "publisher": {
          "@type": "Organization",
          "name": "{{ shop.name | escape }}"
        }
      }
    </script>

    <!-- Reading Progress Bar -->
    {%- if section.settings.show_progress_bar -%}
      <div class="blog-post__progress-bar" data-progress-bar>
        <div class="blog-post__progress-fill" data-progress-fill></div>
      </div>
    {%- endif -%}

    <article class="blog-post" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
      <div class="blog-post__container">

        <!-- Breadcrumb Navigation -->
        {%- if section.settings.show_breadcrumbs -%}
          <nav class="blog-post__breadcrumbs" aria-label="Breadcrumb">
            <ol class="blog-post__breadcrumb-list">
              <li class="blog-post__breadcrumb-item">
                <a href="/">{{ section.settings.breadcrumb_home | default: 'Home' }}</a>
              </li>
              <li class="blog-post__breadcrumb-item">
                <a href="{{ blog.url }}">{{ blog.title }}</a>
              </li>
              <li class="blog-post__breadcrumb-item" aria-current="page">
                {{ current_article.title | escape }}
              </li>
            </ol>
          </nav>
        {%- endif -%}

        <!-- Article Header -->
        <header class="blog-post__header">
          <div class="blog-post__meta-top">
            {%- if current_article.tags.size > 0 -%}
              <div class="blog-post__tags">
                {%- for tag in current_article.tags -%}
                  <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="blog-post__tag">{{ tag }}</a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>

          <h1 class="blog-post__title">{{ current_article.title | escape }}</h1>

          <div class="blog-post__meta">
            {%- if current_article.author != blank -%}
              <span class="blog-post__author">von {{ current_article.author }}</span>
            {%- endif -%}
            <time class="blog-post__date" datetime="{{ current_article.published_at | date: '%Y-%m-%d' }}">
              {{ current_article.published_at | date: '%d. %B %Y' }}
            </time>
            <span class="blog-post__read-time">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <path d="M8 4v4l3 2" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
              </svg>
              {{ read_time }} min Lesezeit
            </span>
          </div>

          {%- if current_article.image != blank and section.settings.show_hero_image -%}
            <div class="blog-post__hero-image">
              {{
                current_article.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'eager',
                  fetchpriority: 'high',
                  sizes: '(min-width: 1200px) 1000px, 100vw',
                  widths: '400,600,800,1000,1200,1400',
                  class: 'blog-post__hero-img',
                  alt: current_article.image.alt | default: current_article.title | escape
              }}
            </div>
          {%- endif -%}
        </header>

        <!-- Main Content Area with Optional Sidebar -->
        <div class="blog-post__layout">

          <!-- Table of Contents (Sidebar) -->
          {%- if section.settings.show_toc -%}
            <aside class="blog-post__sidebar" data-toc-sidebar>
              <nav class="blog-post__toc" aria-label="Inhaltsverzeichnis">
                <h3 class="blog-post__toc-title">Inhalt</h3>
                <ol class="blog-post__toc-list" data-toc-list>
                  <!-- Populated by JS from article headings -->
                </ol>
              </nav>
            </aside>
          {%- endif -%}

          <!-- Article Content with Inline Blocks -->
          <div class="blog-post__content" data-article-content>

            <!-- Blocks positioned at position 0 (before all content) -->
            {%- for block in section.blocks -%}
              {%- if block.settings.position == 0 -%}
                <div class="blog-post__block blog-post__block--{{ block.settings.block_width }} blog-post__block--{{ block.settings.block_align }}" {{ block.shopify_attributes }}>
                  {% render 'blog-post-block', block: block %}
                </div>
              {%- endif -%}
            {%- endfor -%}

            <!-- Split content by paragraphs and insert blocks at positions -->
            {%- assign paragraphs = current_article.content | split: '</p>' -%}
            {%- for p in paragraphs -%}
              {%- unless p == blank -%}
                {{ p }}</p>
                {%- assign para_index = forloop.index -%}
                {%- for block in section.blocks -%}
                  {%- if block.settings.position == para_index -%}
                    <div class="blog-post__block blog-post__block--{{ block.settings.block_width }} blog-post__block--{{ block.settings.block_align }}" {{ block.shopify_attributes }}>
                      {% render 'blog-post-block', block: block %}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endunless -%}
            {%- endfor -%}

            <!-- Blocks with position exceeding paragraph count (rendered after last paragraph) -->
            {%- assign actual_paragraphs = current_article.content | split: '</p>' | size | minus: 1 -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.position > actual_paragraphs and block.settings.position != 0 -%}
                <div class="blog-post__block blog-post__block--{{ block.settings.block_width }} blog-post__block--{{ block.settings.block_align }}" {{ block.shopify_attributes }}>
                  {% render 'blog-post-block', block: block %}
                </div>
              {%- endif -%}
            {%- endfor -%}

          </div>
        </div>

        <!-- Share Buttons -->
        {%- if section.settings.show_share -%}
          <div class="blog-post__share">
            <span class="blog-post__share-label">Teilen:</span>
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ current_article.url | prepend: shop.url | url_encode }}" target="_blank" rel="noopener noreferrer" class="blog-post__share-link" aria-label="Auf Facebook teilen">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="color: {{ section.settings.color_facebook }}"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://twitter.com/intent/tweet?url={{ current_article.url | prepend: shop.url | url_encode }}&text={{ current_article.title | url_encode }}" target="_blank" rel="noopener noreferrer" class="blog-post__share-link" aria-label="Auf X teilen">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="color: {{ section.settings.color_x }}"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ current_article.url | prepend: shop.url | url_encode }}" target="_blank" rel="noopener noreferrer" class="blog-post__share-link" aria-label="Auf LinkedIn teilen">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="color: {{ section.settings.color_linkedin }}"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href="https://wa.me/?text={{ current_article.title | url_encode }}%20{{ current_article.url | prepend: shop.url | url_encode }}" target="_blank" rel="noopener noreferrer" class="blog-post__share-link" aria-label="Auf WhatsApp teilen">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="color: {{ section.settings.color_whatsapp }}"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
            <a href="https://pinterest.com/pin/create/button/?url={{ current_article.url | prepend: shop.url | url_encode }}&description={{ current_article.title | url_encode }}" target="_blank" rel="noopener noreferrer" class="blog-post__share-link" aria-label="Auf Pinterest teilen">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="color: {{ section.settings.color_pinterest }}"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12.017 24c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641 0 12.017 0z"/></svg>
            </a>
            <a href="mailto:?subject={{ current_article.title | url_encode }}&body={{ current_article.url | prepend: shop.url | url_encode }}" class="blog-post__share-link" aria-label="Per E-Mail teilen">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="color: {{ section.settings.color_email }}"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            </a>
          </div>
        {%- endif -%}

        <!-- Author Box -->
        {%- if section.settings.show_author_box and current_article.author != blank -%}
          <div class="blog-post__author-box">
            <div class="blog-post__author-info">
              {%- if section.settings.author_image != blank -%}
                <div class="blog-post__author-avatar">
                  {{ section.settings.author_image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'blog-post__author-photo', alt: current_article.author | escape }}
                </div>
              {%- else -%}
                <div class="blog-post__author-avatar">{{ current_article.author | slice: 0 }}</div>
              {%- endif -%}
              <div>
                <strong class="blog-post__author-name">{{ current_article.author }}</strong>
                {%- if section.settings.author_bio != blank -%}
                  <p class="blog-post__author-bio">{{ section.settings.author_bio }}</p>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}

        <!-- Related Posts -->
        {%- if section.settings.show_related -%}
          {%- assign related_tag = current_article.tags.first -%}
          {%- if related_tag != blank -%}
            <div class="blog-post__related">
              <h3 class="blog-post__related-heading">{{ section.settings.related_heading | default: 'Weitere Beiträge' }}</h3>
              <div class="blog-post__related-grid">
                {%- assign related_count = 0 -%}
                {%- for art in blog.articles -%}
                  {%- if art.handle != current_article.handle and art.tags contains related_tag and related_count < 3 -%}
                    {%- assign related_count = related_count | plus: 1 -%}
                    <a href="{{ art.url }}" class="blog-post__related-card">
                      {%- if art.image != blank -%}
                        <div class="blog-post__related-image">
                          {{ art.image | image_url: width: 400 | image_tag: loading: 'lazy', sizes: '300px', widths: '200,300,400', alt: art.title | escape }}
                        </div>
                      {%- endif -%}
                      <div class="blog-post__related-content">
                        <span class="blog-post__related-date">{{ art.published_at | date: '%d. %B %Y' }}</span>
                        <h4 class="blog-post__related-title">{{ art.title | escape }}</h4>
                      </div>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}

        <!-- Comments Section -->
        {%- if blog.comments_enabled? and section.settings.show_comments -%}
          <div class="blog-post__comments" id="comments">
            <h3 class="blog-post__comments-heading">
              {{ current_article.comments_count }} {{ current_article.comments_count | pluralize: 'Kommentar', 'Kommentare' }}
            </h3>

            {%- paginate current_article.comments by 10 -%}
              {%- for comment in current_article.comments -%}
                <div class="blog-post__comment">
                  <div class="blog-post__comment-avatar">{{ comment.author | slice: 0 }}</div>
                  <div class="blog-post__comment-body">
                    <div class="blog-post__comment-meta">
                      <strong>{{ comment.author }}</strong>
                      <time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">{{ comment.created_at | date: '%d. %B %Y' }}</time>
                    </div>
                    <div class="blog-post__comment-content">{{ comment.content }}</div>
                  </div>
                </div>
              {%- endfor -%}

              {%- if paginate.pages > 1 -%}
                <nav class="blog-post__comment-pagination">{{ paginate | default_pagination }}</nav>
              {%- endif -%}
            {%- endpaginate -%}

            {% form 'new_comment', current_article %}
              <div class="blog-post__comment-form">
                <h4>Kommentar hinterlassen</h4>
                {%- if section.settings.show_moderation_notice and blog.moderated? -%}
                  <div class="blog-post__moderation-notice">
                    Kommentare werden vor Veröffentlichung überprüft.
                  </div>
                {%- endif -%}
                {%- if form.errors -%}
                  <div class="blog-post__form-errors" role="alert">
                    {{ form.errors | default_errors }}
                  </div>
                {%- endif -%}
                <div class="blog-post__form-fields">
                  <div class="blog-post__form-row">
                    <div class="blog-post__form-field">
                      <label for="CommentAuthor">Name</label>
                      <input type="text" name="comment[author]" id="CommentAuthor" value="{{ form.author }}" required>
                    </div>
                    <div class="blog-post__form-field">
                      <label for="CommentEmail">E-Mail</label>
                      <input type="email" name="comment[email]" id="CommentEmail" value="{{ form.email }}" required>
                    </div>
                  </div>
                  <div class="blog-post__form-field">
                    <label for="CommentBody">Kommentar</label>
                    <textarea name="comment[body]" id="CommentBody" rows="5" required>{{ form.body }}</textarea>
                  </div>
                  <button type="submit" class="blog-post__form-submit">Kommentar senden</button>
                </div>
              </div>
            {% endform %}
          </div>
        {%- endif -%}

        <!-- Previous/Next Article Navigation -->
        {%- if section.settings.show_prev_next -%}
          <nav class="blog-post__prev-next" aria-label="Article navigation">
            <div class="blog-post__nav-grid">
              {%- assign prev_article = blog.previous_article -%}
              {%- if prev_article -%}
                <a href="{{ prev_article.url }}" class="blog-post__nav-link blog-post__nav-link--prev">
                  <span class="blog-post__nav-arrow">←</span>
                  <div class="blog-post__nav-content">
                    <span class="blog-post__nav-label">Vorheriger Beitrag</span>
                    <span class="blog-post__nav-title">{{ prev_article.title | escape }}</span>
                  </div>
                </a>
              {%- endif -%}
              {%- assign next_article = blog.next_article -%}
              {%- if next_article -%}
                <a href="{{ next_article.url }}" class="blog-post__nav-link blog-post__nav-link--next">
                  <div class="blog-post__nav-content">
                    <span class="blog-post__nav-label">Nächster Beitrag</span>
                    <span class="blog-post__nav-title">{{ next_article.title | escape }}</span>
                  </div>
                  <span class="blog-post__nav-arrow">→</span>
                </a>
              {%- endif -%}
            </div>
          </nav>
        {%- endif -%}

        <!-- Back to Blog -->
        <div class="blog-post__back">
          <a href="{{ blog.url }}" class="blog-post__back-link">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M10 13L5 8L10 3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            Zurück zum Blog
          </a>
        </div>

      </div>
    </article>

  {%- else -%}
    <div class="blog-post__empty" style="padding: 80px 20px; text-align: center;">
      <p>Diese Section wird auf der Blog-Beitragsseite angezeigt.</p>
    </div>
  {%- endif -%}
</blog-post-enhanced>

<style>
  #shopify-section-{{ section.id }} .blog-post__progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(var(--color-foreground), 0.1);
    z-index: 200;
  }

  #shopify-section-{{ section.id }} .blog-post__progress-fill {
    height: 100%;
    background: rgb(var(--color-button));
    width: 0%;
    transition: width 0.1s linear;
  }

  #shopify-section-{{ section.id }} .blog-post__breadcrumbs {
    margin-bottom: 24px;
  }

  #shopify-section-{{ section.id }} .blog-post__breadcrumb-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .blog-post__breadcrumb-item:not(:last-child)::after {
    content: '/';
    margin-left: 8px;
    color: rgba(var(--color-foreground), 0.4);
  }

  #shopify-section-{{ section.id }} .blog-post__breadcrumb-item a {
    color: rgb(var(--color-link));
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .blog-post__breadcrumb-item a:hover {
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .blog-post__breadcrumb-item[aria-current="page"] {
    color: rgba(var(--color-foreground), 0.6);
  }

  #shopify-section-{{ section.id }} .blog-post {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  #shopify-section-{{ section.id }} .blog-post__header {
    text-align: center;
    margin-bottom: 48px;
  }

  #shopify-section-{{ section.id }} .blog-post__meta-top {
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .blog-post__tags {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .blog-post__tag {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: rgb(var(--color-button));
    background: rgba(var(--color-button), 0.1);
    padding: 4px 12px;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s;
  }

  #shopify-section-{{ section.id }} .blog-post__tag:hover {
    background: rgba(var(--color-button), 0.2);
  }

  #shopify-section-{{ section.id }} .blog-post__title {
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 800;
    color: rgb(var(--color-foreground));
    margin: 0 0 16px 0;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .blog-post__meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
