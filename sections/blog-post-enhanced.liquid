<script>
  class BlogPostEnhanced extends HTMLElement {
    connectedCallback() {
      this.setupProgressBar();
      this.setupTableOfContents();
      this.setupCharts();
      this.setupBeforeAfter();
      this.setupCounters();
      this.setupEditorEvents();
    }

    setupProgressBar() {
      const fill = this.querySelector('[data-progress-fill]');
      if (!fill) return;
      const content = this.querySelector('[data-article-content]');
      if (!content) return;

      const update = () => {
        const rect = content.getBoundingClientRect();
        const total = content.scrollHeight;
        const scrolled = Math.max(0, -rect.top);
        const pct = Math.min(100, (scrolled / (total - window.innerHeight)) * 100);
        fill.style.width = pct + '%';
      };

      window.addEventListener('scroll', update, { passive: true });
      this._cleanupProgress = () => window.removeEventListener('scroll', update);
    }

    setupTableOfContents() {
      const tocList = this.querySelector('[data-toc-list]');
      const content = this.querySelector('[data-article-content]');
      if (!tocList || !content) return;

      const headings = content.querySelectorAll('h2');
      headings.forEach((h, i) => {
        const id = 'heading-' + i;
        h.id = id;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '#' + id;
        a.textContent = h.textContent;
        li.appendChild(a);
        tocList.appendChild(li);
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            tocList.querySelectorAll('a').forEach(a => a.classList.remove('active'));
            const link = tocList.querySelector(`a[href="#${entry.target.id}"]`);
            if (link) link.classList.add('active');
          }
        });
      }, { rootMargin: '-100px 0px -70% 0px' });

      headings.forEach(h => observer.observe(h));
      this._tocObserver = observer;
    }

    setupCharts() {
      this.querySelectorAll('[data-chart]').forEach(chartEl => {
        const canvas = chartEl.querySelector('canvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        const type = chartEl.dataset.chartType || 'bar';
        const labels = (chartEl.dataset.chartLabels || '').split(',').map(s => s.trim());
        const values = (chartEl.dataset.chartValues || '').split(',').map(s => parseFloat(s.trim()));
        const colors = (chartEl.dataset.chartColors || '').split(',').map(s => s.trim());

        if (!labels.length || !values.length) return;

        const maxVal = Math.max(...values);
        const w = canvas.width;
        const h = canvas.height;
        const barWidth = (w - 60) / labels.length;
        const chartHeight = h - 60;

        ctx.clearRect(0, 0, w, h);

        ctx.strokeStyle = 'rgba(0,0,0,0.05)';
        for (let i = 0; i <= 4; i++) {
          const y = 20 + (chartHeight / 4) * i;
          ctx.beginPath();
          ctx.moveTo(40, y);
          ctx.lineTo(w - 10, y);
          ctx.stroke();
        }

        if (type === 'bar') {
          values.forEach((val, i) => {
            const barH = (val / maxVal) * chartHeight;
            const x = 50 + i * barWidth;
            const y = 20 + chartHeight - barH;
            ctx.fillStyle = colors[i] || `hsl(${i * 60}, 60%, 50%)`;
            ctx.beginPath();
            ctx.roundRect(x, y, barWidth * 0.7, barH, 4);
            ctx.fill();
            ctx.fillStyle = '#666';
            ctx.font = '12px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(labels[i] || '', x + barWidth * 0.35, h - 8);
            ctx.fillText(val, x + barWidth * 0.35, y - 6);
          });
        } else if (type === 'line') {
          ctx.strokeStyle = colors[0] || 'hsl(210, 60%, 50%)';
          ctx.lineWidth = 2;
          ctx.beginPath();
          values.forEach((val, i) => {
            const x = 50 + i * barWidth + barWidth * 0.35;
            const y = 20 + chartHeight - (val / maxVal) * chartHeight;
            if (i === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          });
          ctx.stroke();
          values.forEach((val, i) => {
            const x = 50 + i * barWidth + barWidth * 0.35;
            const y = 20 + chartHeight - (val / maxVal) * chartHeight;
            ctx.beginPath();
            ctx.arc(x, y, 4, 0, Math.PI * 2);
            ctx.fillStyle = colors[0] || 'hsl(210, 60%, 50%)';
            ctx.fill();
            ctx.fillStyle = '#666';
            ctx.font = '12px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(labels[i] || '', x, h - 8);
          });
        }
      });
    }

    setupBeforeAfter() {
      this.querySelectorAll('[data-before-after]').forEach(el => {
        const slider = el.querySelector('[data-ba-slider]');
        const after = el.querySelector('[data-ba-after]');
        const handle = el.querySelector('[data-ba-handle]');
        if (!slider || !after || !handle) return;

        slider.addEventListener('input', () => {
          const val = slider.value;
          after.style.clipPath = `inset(0 ${100 - val}% 0 0)`;
          handle.style.left = val + '%';
        });
      });
    }

    setupCounters() {
      const counters = this.querySelectorAll('[data-counters]');
      if (!counters.length) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.querySelectorAll('[data-count-to]').forEach(counter => {
              const target = parseInt(counter.dataset.countTo);
              const numEl = counter.querySelector('.blog-post__counter-number');
              if (!numEl || numEl.dataset.animated) return;
              numEl.dataset.animated = 'true';
              let current = 0;
              const step = Math.max(1, Math.ceil(target / 60));
              const interval = setInterval(() => {
                current += step;
                if (current >= target) {
                  current = target;
                  clearInterval(interval);
                }
                numEl.textContent = current.toLocaleString('de-DE');
              }, 20);
            });
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.3 });

      counters.forEach(c => observer.observe(c));
      this._counterObserver = observer;
    }

    setupEditorEvents() {
      document.addEventListener('shopify:section:load', (e) => {
        if (e.detail.sectionId === this.closest('[data-shopify-section-id]')?.dataset.shopifySectionId) {
          this.setupCharts();
          this.setupBeforeAfter();
          this.setupCounters();
        }
      });

      document.addEventListener('shopify:block:select', (e) => {
        this.setupCharts();
        this.setupBeforeAfter();
        this.setupCounters();
      });
    }

    disconnectedCallback() {
      if (this._cleanupProgress) this._cleanupProgress();
      if (this._tocObserver) this._tocObserver.disconnect();
      if (this._counterObserver) this._counterObserver.disconnect();
    }
  }

  if (!customElements.get('blog-post-enhanced')) {
    customElements.define('blog-post-enhanced', BlogPostEnhanced);
  }
</script>

