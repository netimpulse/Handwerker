{{ 'craftsman-pages.css' | asset_url | stylesheet_tag }}
<script src="{{ 'craftsman-pages.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign story_blocks = section.blocks | where: 'type', 'story'
  assign value_blocks = section.blocks | where: 'type', 'value'
  assign timeline_blocks = section.blocks | where: 'type', 'timeline'
  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign team_blocks = section.blocks | where: 'type', 'team_member'
  assign cert_blocks = section.blocks | where: 'type', 'certificate'
  assign cta_blocks = section.blocks | where: 'type', 'cta'
-%}

<div class="cf-page color-{{ section.settings.color_scheme.id }} gradient section-{{ section.id }}-padding">
  <cf-reveal-group>
    {%- comment -%} ------------------------------ Intro + story rows {%- endcomment -%}
    <section class="cf-band">
      <div class="page-width">
        {% render 'cf-section-head', kicker: section.settings.kicker, heading: section.settings.heading, text: section.settings.text, heading_tag: 'h1', align: 'center' %}

        {%- for block in story_blocks -%}
          {%- assign row_alt = forloop.index | modulo: 2 -%}
          <article class="cf-row {% if row_alt == 0 %}cf-row--flip{% endif %} cf-reveal" {{ block.shopify_attributes }}>
            <div class="cf-row__media">
              {%- if block.settings.image != blank -%}
                {%- assign img_alt = block.settings.image.alt | default: block.settings.heading | escape -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag: widths: '480, 750, 990, 1200', sizes: '(min-width: 900px) 45vw, 100vw', alt: img_alt, loading: 'lazy'
                }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="cf-row__content">
              {%- if block.settings.kicker != blank -%}
                <p class="cf-kicker">{{ block.settings.kicker | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="cf-heading cf-heading--sm">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="cf-rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </section>

    {%- comment -%} ------------------------------ Values {%- endcomment -%}
    {%- if value_blocks.size > 0 -%}
      <section class="cf-band cf-band--tint">
        <div class="page-width">
          {% render 'cf-section-head', kicker: section.settings.values_kicker, heading: section.settings.values_heading, align: 'center' %}
          <div class="cf-grid cf-grid--3">
            {%- for block in value_blocks -%}
              <div class="cf-value cf-reveal" {{ block.shopify_attributes }}>
                <span class="cf-card__icon">{% render 'icon-craftsman', icon: block.settings.icon %}</span>
                {%- if block.settings.title != blank -%}
                  <h3 class="cf-card__title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="cf-card__text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ------------------------------ Timeline {%- endcomment -%}
    {%- if timeline_blocks.size > 0 -%}
      <section class="cf-band">
        <div class="page-width">
          {% render 'cf-section-head', kicker: section.settings.timeline_kicker, heading: section.settings.timeline_heading %}
          <div class="cf-timeline">
            {%- for block in timeline_blocks -%}
              <div class="cf-timeline__item cf-reveal" {{ block.shopify_attributes }}>
                {%- if block.settings.year != blank -%}
                  <span class="cf-timeline__year">{{ block.settings.year | escape }}</span>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="cf-timeline__title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="cf-timeline__text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ------------------------------ Stats {%- endcomment -%}
    {%- if stat_blocks.size > 0 -%}
      <section class="cf-band cf-band--tint cf-band--grid-bg">
        <div class="page-width">
          <div class="cf-stats">
            {%- for block in stat_blocks -%}
              {% render 'cf-stat', value: block.settings.value, prefix: block.settings.prefix, suffix: block.settings.suffix, label: block.settings.label, attrs: block.shopify_attributes %}
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ------------------------------ Team {%- endcomment -%}
    {%- if team_blocks.size > 0 -%}
      <section class="cf-band">
        <div class="page-width">
          {% render 'cf-section-head', kicker: section.settings.team_kicker, heading: section.settings.team_heading, text: section.settings.team_text, align: 'center' %}
          <div class="cf-grid cf-grid--4">
            {%- for block in team_blocks -%}
              {% render 'cf-team-card', image: block.settings.image, name: block.settings.name, role: block.settings.role, quals: block.settings.quals, attrs: block.shopify_attributes %}
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ------------------------------ Certificates {%- endcomment -%}
    {%- if cert_blocks.size > 0 -%}
      <section class="cf-band cf-band--tint">
        <div class="page-width">
          {% render 'cf-section-head', kicker: section.settings.certs_kicker, heading: section.settings.certs_heading, align: 'center' %}
          <div class="cf-logos">
            {%- for block in cert_blocks -%}
              <div class="cf-logos__item cf-reveal" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {%- assign cert_alt = block.settings.image.alt | default: block.settings.label | escape -%}
                  {{ block.settings.image | image_url: width: 240 | image_tag: widths: '120, 240', alt: cert_alt, loading: 'lazy' }}
                {%- else -%}
                  {% render 'icon-craftsman', icon: 'certificate' %}
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <span class="cf-logos__label">{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ------------------------------ CTA {%- endcomment -%}
    {%- if cta_blocks.size > 0 -%}
      <section class="cf-band">
        <div class="page-width">
          {%- for block in cta_blocks -%}
            {% render 'cf-cta-banner', heading: block.settings.heading, text: block.settings.text, button_label: block.settings.button_label, button_link: block.settings.button_link, phone: block.settings.phone, attrs: block.shopify_attributes %}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  </cf-reveal-group>
</div>

{% schema %}
{
  "name": "t:sections.page-about.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.page-about.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.cf.group_intro"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.cf.kicker",
      "default": "t:sections.cf.defaults.about_kicker"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.cf.heading",
      "default": "t:sections.cf.defaults.about_heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.cf.text"
    },
    {
      "type": "header",
      "content": "t:sections.cf.group_values"
    },
    {
      "type": "text",
      "id": "values_kicker",
      "label": "t:sections.cf.kicker",
      "default": "t:sections.cf.defaults.values_kicker"
    },
    {
      "type": "text",
      "id": "values_heading",
      "label": "t:sections.cf.heading",
      "default": "t:sections.cf.defaults.values_heading"
    },
    {
      "type": "header",
      "content": "t:sections.cf.group_timeline"
    },
    {
      "type": "text",
      "id": "timeline_kicker",
      "label": "t:sections.cf.kicker",
      "default": "t:sections.cf.defaults.timeline_kicker"
    },
    {
      "type": "text",
      "id": "timeline_heading",
      "label": "t:sections.cf.heading",
      "default": "t:sections.cf.defaults.timeline_heading"
    },
    {
      "type": "header",
      "content": "t:sections.cf.group_team"
    },
    {
      "type": "text",
      "id": "team_kicker",
      "label": "t:sections.cf.kicker",
      "default": "t:sections.cf.defaults.team_kicker"
    },
    {
      "type": "text",
      "id": "team_heading",
      "label": "t:sections.cf.heading",
      "default": "t:sections.cf.defaults.team_heading"
    },
    {
      "type": "textarea",
      "id": "team_text",
      "label": "t:sections.cf.text"
    },
    {
      "type": "header",
      "content": "t:sections.cf.group_certificates"
    },
    {
      "type": "text",
      "id": "certs_kicker",
      "label": "t:sections.cf.kicker",
      "default": "t:sections.cf.defaults.certs_kicker"
    },
    {
      "type": "text",
      "id": "certs_heading",
      "label": "t:sections.cf.heading",
      "default": "t:sections.cf.defaults.certs_heading"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "t:sections.cf.blocks.story.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.cf.image"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.cf.kicker",
          "default": "t:sections.cf.defaults.story_kicker"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.cf.heading",
          "default": "t:sections.cf.defaults.story_heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.cf.text",
          "default": "t:sections.cf.defaults.story_text"
        }
      ]
    },
    {
      "type": "value",
      "name": "t:sections.cf.blocks.value.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.cf.icon",
          "default": "shield",
          "options": [
            { "value": "shield", "label": "t:sections.cf.icons.shield" },
            { "value": "award", "label": "t:sections.cf.icons.award" },
            { "value": "handshake", "label": "t:sections.cf.icons.handshake" },
            { "value": "clock", "label": "t:sections.cf.icons.clock" },
            { "value": "leaf", "label": "t:sections.cf.icons.leaf" },
            { "value": "users", "label": "t:sections.cf.icons.users" },
            { "value": "check", "label": "t:sections.cf.icons.check" },
            { "value": "wrench", "label": "t:sections.cf.icons.wrench" },
            { "value": "ruler", "label": "t:sections.cf.icons.ruler" },
            { "value": "euro", "label": "t:sections.cf.icons.euro" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.cf.title",
          "default": "t:sections.cf.defaults.value_title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.cf.text",
          "default": "t:sections.cf.defaults.value_text"
        }
      ]
    },
    {
      "type": "timeline",
      "name": "t:sections.cf.blocks.timeline.name",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "t:sections.cf.year",
          "default": "t:sections.cf.defaults.timeline_year"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.cf.title",
          "default": "t:sections.cf.defaults.timeline_title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.cf.text"
        }
      ]
    },
    {
      "type": "stat",
      "name": "t:sections.cf.blocks.stat.name",
      "settings": [
        {
          "type": "number",
          "id": "value",
          "label": "t:sections.cf.value",
          "default": 25
        },
        {
          "type": "text",
          "id": "prefix",
          "label": "t:sections.cf.prefix"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "t:sections.cf.suffix",
          "default": "+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.cf.label",
          "default": "t:sections.cf.defaults.stat_label"
        }
      ]
    },
    {
      "type": "team_member",
      "name": "t:sections.cf.blocks.team_member.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.cf.image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.cf.name",
          "default": "t:sections.cf.defaults.team_name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "t:sections.cf.role",
          "default": "t:sections.cf.defaults.team_role"
        },
        {
          "type": "text",
          "id": "quals",
          "label": "t:sections.cf.quals"
        }
      ]
    },
    {
      "type": "certificate",
      "name": "t:sections.cf.blocks.certificate.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.cf.logo_image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.cf.label",
          "default": "t:sections.cf.defaults.certificate_label"
        }
      ]
    },
    {
      "type": "cta",
      "name": "t:sections.cf.blocks.cta.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.cf.heading",
          "default": "t:sections.cf.defaults.cta_heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.cf.text",
          "default": "t:sections.cf.defaults.cta_text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.cf.button_label",
          "default": "t:sections.cf.defaults.cta_button"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.cf.button_link"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "t:sections.cf.phone"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.page-about.preset_name",
      "blocks": [
        { "type": "story" },
        { "type": "story" },
        { "type": "value" },
        { "type": "value" },
        { "type": "value" },
        { "type": "timeline" },
        { "type": "timeline" },
        { "type": "timeline" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "team_member" },
