{% comment %}
  Blog Overview Section - Craftsman Theme
  Full blog overview page with category filtering, fuzzy search, sorting, read time
  Natively integrates with Shopify's blog/article system
{% endcomment %}

{%- assign current_blog = blog | default: blogs[section.settings.blog] -%}

<blog-overview class="color-{{ section.settings.color_scheme }}">
  <div class="blog-overview" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="blog-overview__container">

      {%- if section.settings.heading != blank -%}
        <div class="blog-overview__header">
          {%- if section.settings.label_text != blank -%}
            <span class="blog-overview__label">{{ section.settings.label_text }}</span>
          {%- endif -%}
          <h1 class="blog-overview__heading">{{ section.settings.heading }}</h1>
          {%- if section.settings.subheading != blank -%}
            <p class="blog-overview__subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if current_blog != blank and current_blog.articles_count > 0 -%}

        <!-- Controls: Search + Filters + Sort -->
        <div class="blog-overview__controls">
          <div class="blog-overview__search-wrapper">
            <svg class="blog-overview__search-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="1.5"/>
              <path d="M13.5 13.5L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <input
              type="search"
              class="blog-overview__search"
              placeholder="{{ section.settings.search_placeholder | default: 'Beiträge durchsuchen...' }}"
              aria-label="Blog durchsuchen"
              data-search-input
              autocomplete="off"
            >
            <button class="blog-overview__search-clear" data-search-clear hidden aria-label="Suche leeren">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </button>

            <!-- Predictive search dropdown -->
            <div class="blog-overview__search-dropdown" data-search-dropdown hidden>
              <div class="blog-overview__search-loading" data-search-loading hidden>
                <span class="blog-overview__search-spinner"></span>
              </div>
              <ul class="blog-overview__search-results" data-search-results role="listbox">
              </ul>
              <div class="blog-overview__search-results-empty" data-search-empty hidden>
                <p>Keine Beiträge gefunden</p>
              </div>
            </div>
          </div>

          <div class="blog-overview__filters-row">
            <div class="blog-overview__tags" data-filter-tags>
              <button class="blog-overview__filter-btn blog-overview__filter-btn--active" data-filter="all">Alle</button>
              {%- assign all_tags = '' -%}
              {%- for article in current_blog.articles -%}
                {%- for tag in article.tags -%}
                  {%- unless all_tags contains tag -%}
                    {%- if all_tags != '' -%}{%- assign all_tags = all_tags | append: '|||' -%}{%- endif -%}
                    {%- assign all_tags = all_tags | append: tag -%}
                  {%- endunless -%}
                {%- endfor -%}
              {%- endfor -%}
              {%- assign unique_tags = all_tags | split: '|||' | sort -%}
              {%- for tag in unique_tags -%}
                <button class="blog-overview__filter-btn" data-filter="{{ tag | handleize }}">{{ tag }}</button>
              {%- endfor -%}
            </div>

            <div class="blog-overview__sort">
              <select class="blog-overview__sort-select" data-sort-select aria-label="Sortierung">
                <option value="newest">Neueste zuerst</option>
                <option value="oldest">Älteste zuerst</option>
                <option value="title_asc">A – Z</option>
                <option value="title_desc">Z – A</option>
              </select>
            </div>
          </div>

          <div class="blog-overview__results-info" data-results-info>
            <span data-results-count>{{ current_blog.articles_count }}</span> von {{ current_blog.articles_count }} Beiträgen
          </div>
        </div>

        <!-- Articles Grid -->
        <div class="blog-overview__articles" data-articles-container>
          {%- paginate current_blog.articles by section.settings.articles_per_page -%}
            {%- for article in current_blog.articles -%}
              {%- assign word_count = article.content | strip_html | split: ' ' | size -%}
              {%- assign read_time = word_count | divided_by: 200 | at_least: 1 -%}
              {%- assign tags_handleized = '' -%}
              {%- for tag in article.tags -%}
                {%- assign tags_handleized = tags_handleized | append: tag | handleize | append: ' ' -%}
              {%- endfor -%}

              <article
                class="blog-overview__article"
                data-article
                data-tags="{{ tags_handleized | strip }}"
                data-title="{{ article.title | escape | downcase }}"
                data-content="{{ article.excerpt_or_content | strip_html | truncatewords: 80 | escape | downcase }}"
                data-date="{{ article.published_at | date: '%s' }}"
                data-author="{{ article.author | escape | downcase }}"
              >
                {%- if article.image != blank -%}
                  <a href="{{ article.url }}" class="blog-overview__article-image-link" tabindex="-1" aria-hidden="true">
                    <div class="blog-overview__article-image-wrapper">
                      {{
                        article.image
                        | image_url: width: 600
                        | image_tag:
                          loading: 'lazy',
                          sizes: '(min-width: 1200px) 400px, (min-width: 768px) 50vw, 100vw',
                          widths: '300,400,600',
                          class: 'blog-overview__article-image',
                          alt: article.image.alt | default: article.title | escape
                      }}
                    </div>
                  </a>
                {%- endif -%}

                <div class="blog-overview__article-body">
                  <div class="blog-overview__article-meta">
                    {%- if article.tags.size > 0 -%}
                      <span class="blog-overview__article-tag">{{ article.tags.first }}</span>
                    {%- endif -%}
                    <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                      {{ article.published_at | date: '%d. %B %Y' }}
                    </time>
                    <span class="blog-overview__article-read-time">{{ read_time }} min</span>
                  </div>

                  <h2 class="blog-overview__article-title">
                    <a href="{{ article.url }}">{{ article.title | escape }}</a>
                  </h2>

                  {%- if article.excerpt_or_content != blank -%}
                    <p class="blog-overview__article-excerpt">
                      {{ article.excerpt_or_content | strip_html | truncatewords: 25 }}
                    </p>
                  {%- endif -%}

                  <div class="blog-overview__article-footer">
                    {%- if article.author != blank -%}
                      <span class="blog-overview__article-author">von {{ article.author }}</span>
                    {%- endif -%}
                    {%- if article.comments_count > 0 -%}
                      <span class="blog-overview__article-comments">{{ article.comments_count }} {{ article.comments_count | pluralize: 'Kommentar', 'Kommentare' }}</span>
                    {%- endif -%}
                    <a href="{{ article.url }}" class="blog-overview__article-link">
                      Weiterlesen
                      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            {%- endfor -%}

            {%- if paginate.pages > 1 -%}
              <nav class="blog-overview__pagination" aria-label="Blog pagination">
                {{ paginate | default_pagination: next: '→', previous: '←' }}
              </nav>
            {%- endif -%}
          {%- endpaginate -%}
        </div>

        <!-- No results message -->
        <div class="blog-overview__no-results" data-no-results hidden>
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <circle cx="20" cy="20" r="14" stroke="currentColor" stroke-width="2" fill="none"/>
            <path d="M30 30l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M14 20h12M20 14v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
          </svg>
          <p>Keine Beiträge gefunden. Versuchen Sie einen anderen Suchbegriff.</p>
        </div>

      {%- else -%}
        <div class="blog-overview__empty">
          <p>Wählen Sie einen Blog im Theme Editor aus oder erstellen Sie Blog-Beiträge.</p>
        </div>
      {%- endif -%}

    </div>
  </div>
</blog-overview>

<style>
  #shopify-section-{{ section.id }} .blog-overview {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  #shopify-section-{{ section.id }} .blog-overview__header {
    text-align: center;
    margin-bottom: 40px;
  }

  #shopify-section-{{ section.id }} .blog-overview__label {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(var(--color-button));
    background: rgba(var(--color-button), 0.1);
    padding: 4px 14px;
    border-radius: 20px;
    margin-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .blog-overview__heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: rgb(var(--color-foreground));
    margin: 0 0 12px 0;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .blog-overview__subheading {
    font-size: 1.0625rem;
    color: rgba(var(--color-foreground), 0.7);
    margin: 0 auto;
    max-width: 600px;
    line-height: 1.6;
  }

  /* Controls */
  #shopify-section-{{ section.id }} .blog-overview__controls {
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-icon {
    position: absolute;
    left: 16px;
    color: rgba(var(--color-foreground), 0.4);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .blog-overview__search {
    width: 100%;
    padding: 14px 44px 14px 48px;
    border: 2px solid rgb(var(--color-border));
    border-radius: 10px;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.2s;
  }

  #shopify-section-{{ section.id }} .blog-overview__search:focus {
    outline: none;
    border-color: rgb(var(--color-button));
    box-shadow: 0 0 0 3px rgba(var(--color-button), 0.1);
  }

  #shopify-section-{{ section.id }} .blog-overview__search-clear {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(var(--color-foreground), 0.5);
    padding: 4px;
    display: flex;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-clear:hover {
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .blog-overview__filters-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .blog-overview__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex: 1;
  }

  #shopify-section-{{ section.id }} .blog-overview__filter-btn {
    padding: 8px 18px;
    border: 2px solid rgb(var(--color-border));
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-size: 1rem;
    font-family: inherit;
    font-weight: 500;
    border-radius: 24px;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .blog-overview__filter-btn:hover {
    border-color: rgb(var(--color-button));
    color: rgb(var(--color-button));
  }

  #shopify-section-{{ section.id }} .blog-overview__filter-btn--active {
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    border-color: rgb(var(--color-button));
  }

  #shopify-section-{{ section.id }} .blog-overview__sort-select {
    padding: 8px 16px;
    border: 2px solid rgb(var(--color-border));
    border-radius: 8px;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-size: 1rem;
    font-family: inherit;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .blog-overview__results-info {
    font-size: 14px;
    color: rgba(var(--color-foreground), 0.5);
  }

  /* Articles Grid */
  #shopify-section-{{ section.id }} .blog-overview__articles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .blog-overview__article {
    background: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-border));
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .blog-overview__article:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(var(--color-foreground), 0.08);
  }

  #shopify-section-{{ section.id }} .blog-overview__article[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .blog-overview__article-image-link {
    display: block;
  }

  #shopify-section-{{ section.id }} .blog-overview__article-image-wrapper {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.05);
  }

  #shopify-section-{{ section.id }} .blog-overview__article-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  #shopify-section-{{ section.id }} .blog-overview__article:hover .blog-overview__article-image {
    transform: scale(1.05);
  }

  #shopify-section-{{ section.id }} .blog-overview__article-body {
    padding: 20px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  #shopify-section-{{ section.id }} .blog-overview__article-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 13px;
    color: rgba(var(--color-foreground), 0.5);
  }

  #shopify-section-{{ section.id }} .blog-overview__article-tag {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: rgb(var(--color-button));
    background: rgba(var(--color-button), 0.1);
    padding: 3px 10px;
    border-radius: 6px;
  }

  #shopify-section-{{ section.id }} .blog-overview__article-read-time {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  #shopify-section-{{ section.id }} .blog-overview__article-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .blog-overview__article-title a {
    color: rgb(var(--color-foreground));
    text-decoration: none;
    transition: color 0.2s;
  }

  #shopify-section-{{ section.id }} .blog-overview__article-title a:hover {
    color: rgb(var(--color-link));
  }

  #shopify-section-{{ section.id }} .blog-overview__article-excerpt {
    font-size: 1rem;
    color: rgba(var(--color-foreground), 0.7);
    line-height: 1.7;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .blog-overview__article-footer {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 12px;
    border-top: 1px solid rgba(var(--color-border), 0.5);
    margin-top: auto;
    font-size: 14px;
    color: rgba(var(--color-foreground), 0.5);
  }

  #shopify-section-{{ section.id }} .blog-overview__article-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
    color: rgb(var(--color-button));
    text-decoration: none;
    margin-left: auto;
    transition: gap 0.2s;
  }

  #shopify-section-{{ section.id }} .blog-overview__article-link:hover {
    gap: 8px;
  }

  /* Pagination */
  #shopify-section-{{ section.id }} .blog-overview__pagination {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    gap: 8px;
    padding-top: 40px;
  }

  #shopify-section-{{ section.id }} .blog-overview__pagination a,
  #shopify-section-{{ section.id }} .blog-overview__pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    border: 1px solid rgb(var(--color-border));
    border-radius: 8px;
    color: rgb(var(--color-foreground));
    text-decoration: none;
    font-size: 1rem;
    transition: all 0.2s;
  }

  #shopify-section-{{ section.id }} .blog-overview__pagination a:hover {
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    border-color: rgb(var(--color-button));
  }

  #shopify-section-{{ section.id }} .blog-overview__pagination span.current {
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    border-color: rgb(var(--color-button));
  }

  /* No results */
  #shopify-section-{{ section.id }} .blog-overview__no-results {
    text-align: center;
    padding: 60px 20px;
    color: rgba(var(--color-foreground), 0.5);
  }

  #shopify-section-{{ section.id }} .blog-overview__no-results p {
    font-size: 1rem;
    margin-top: 16px;
  }

  #shopify-section-{{ section.id }} .blog-overview__empty {
    text-align: center;
    padding: 60px 20px;
    color: rgba(var(--color-foreground), 0.5);
    font-size: 1rem;
  }

  /* Predictive search dropdown */
  #shopify-section-{{ section.id }} .blog-overview__search-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: 8px;
    background: rgb(var(--color-background));
    border: 2px solid rgb(var(--color-border));
    border-radius: 10px;
    box-shadow: 0 8px 32px rgba(var(--color-foreground), 0.12);
    z-index: 10;
    max-height: 400px;
    overflow-y: auto;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-dropdown[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-loading {
    padding: 16px;
    text-align: center;
    color: rgba(var(--color-foreground), 0.5);
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-loading[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-spinner {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(var(--color-button), 0.3);
    border-top-color: rgb(var(--color-button));
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  #shopify-section-{{ section.id }} .blog-overview__search-results {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-result {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(var(--color-border), 0.5);
    cursor: pointer;
    transition: background-color 0.15s;
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-result:last-child {
    border-bottom: none;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-result:hover,
  #shopify-section-{{ section.id }} .blog-overview__search-result--selected,
  #shopify-section-{{ section.id }} .blog-overview__search-result[aria-selected="true"] {
    background-color: rgba(var(--color-button), 0.08);
  }

  #shopify-section-{{ section.id }} .blog-overview__search-result-image {
    width: 48px;
    height: 48px;
    border-radius: 6px;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.05);
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-result-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-result-content {
    flex: 1;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-result-title {
    font-size: 14px;
    font-weight: 600;
    color: rgb(var(--color-foreground));
    margin: 0 0 4px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-result-excerpt {
    font-size: 13px;
    color: rgba(var(--color-foreground), 0.6);
    margin: 0 0 4px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-result-meta {
    font-size: 12px;
    color: rgba(var(--color-foreground), 0.5);
  }

  #shopify-section-{{ section.id }} .blog-overview__search-results-empty {
    padding: 16px;
    text-align: center;
    color: rgba(var(--color-foreground), 0.5);
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .blog-overview__search-results-empty[hidden] {
    display: none;
  }

  /* Responsive */
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .blog-overview__articles {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .blog-overview__filters-row {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .blog-overview__tags {
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 4px;
    }

    #shopify-section-{{ section.id }} .blog-overview__article-body {
      padding: 16px 20px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .blog-overview__article,
    #shopify-section-{{ section.id }} .blog-overview__article-image {
      transition: none;
    }
  }
</style>

<script>
  class BlogOverview extends HTMLElement {
    connectedCallback() {
      this.articles = [...this.querySelectorAll('[data-article]')];
      this.searchInput = this.querySelector('[data-search-input]');
      this.searchClear = this.querySelector('[data-search-clear]');
      this.filterBtns = [...this.querySelectorAll('[data-filter]')];
      this.sortSelect = this.querySelector('[data-sort-select]');
      this.resultsCount = this.querySelector('[data-results-count]');
      this.noResults = this.querySelector('[data-no-results]');
      this.container = this.querySelector('[data-articles-container]');

      // Predictive search elements
      this.searchDropdown = this.querySelector('[data-search-dropdown]');
      this.searchResults = this.querySelector('[data-search-results]');
      this.searchLoading = this.querySelector('[data-search-loading]');
      this.searchEmpty = this.querySelector('[data-search-empty]');

      this.currentFilter = 'all';
      this.currentSearch = '';
      this.searchTimeout = null;
      this.selectedIndex = -1;

      if (this.searchInput) {
        this.searchInput.addEventListener('input', (e) => {
          this.currentSearch = e.target.value.trim().toLowerCase();
          this.searchClear.hidden = this.currentSearch === '';
          this.applyFilters();
          this.handlePredictiveSearch();
        });

        this.searchInput.addEventListener('focus', () => {
          if (this.currentSearch.length >= 3) {
            this.searchDropdown.hidden = false;
          }
        });

        this.searchInput.addEventListener('keydown', (e) => {
          if (!this.searchDropdown.hidden) {
            switch (e.key) {
              case 'Escape':
                this.closeDropdown();
                break;
              case 'ArrowDown':
                e.preventDefault();
                this.selectedIndex++;
                this.updateSelection();
                break;
              case 'ArrowUp':
                e.preventDefault();
                this.selectedIndex--;
                this.updateSelection();
                break;
              case 'Enter':
                if (this.selectedIndex >= 0) {
                  e.preventDefault();
                  const items = [...this.searchResults.querySelectorAll('[data-search-result]')];
                  if (items[this.selectedIndex]) {
                    items[this.selectedIndex].click();
                  }
                }
                break;
            }
          }
        });
      }

      if (this.searchClear) {
        this.searchClear.addEventListener('click', () => {
          this.searchInput.value = '';
          this.currentSearch = '';
          this.searchClear.hidden = true;
          this.closeDropdown();
          this.applyFilters();
          this.searchInput.focus();
        });
      }

      this.filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          this.filterBtns.forEach(b => b.classList.remove('blog-overview__filter-btn--active'));
          btn.classList.add('blog-overview__filter-btn--active');
          this.currentFilter = btn.dataset.filter;
          this.applyFilters();
        });
      });

      if (this.sortSelect) {
        this.sortSelect.addEventListener('change', () => this.applySort());
      }

      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!this.contains(e.target)) {
          this.closeDropdown();
        }
      });
    }

    handlePredictiveSearch() {
      clearTimeout(this.searchTimeout);
      this.selectedIndex = -1;

      if (this.currentSearch.length < 3) {
        this.closeDropdown();
        return;
      }

      this.searchLoading.hidden = false;
      this.searchEmpty.hidden = true;
      this.searchResults.innerHTML = '';
      this.searchDropdown.hidden = false;

      this.searchTimeout = setTimeout(() => {
        this.fetchPredictiveResults();
      }, 300);
    }

    async fetchPredictiveResults() {
      try {
        const root = window.Shopify?.routes?.root || '/';
        const query = encodeURIComponent(this.currentSearch);
        const response = await fetch(
          `${root}search/suggest.json?q=${query}&resources[type]=article&resources[limit]=5`
        );
        const data = await response.json();

        this.searchLoading.hidden = true;

        if (data.resources && data.resources.results && data.resources.results.length > 0) {
          const articles = data.resources.results.filter(r => r.object_type === 'article');
          this.renderSearchResults(articles);
          this.searchEmpty.hidden = true;
        } else {
          this.searchResults.innerHTML = '';
          this.searchEmpty.hidden = false;
        }
      } catch (error) {
        console.error('Predictive search error:', error);
        this.searchLoading.hidden = true;
        this.searchEmpty.hidden = false;
      }
    }

    renderSearchResults(articles) {
      this.searchResults.innerHTML = '';

      articles.forEach((article, index) => {
        const li = document.createElement('li');
        li.className = 'blog-overview__search-result';
        li.dataset.searchResult = true;
        li.setAttribute('role', 'option');
        li.setAttribute('tabindex', '-1');

        const imageHtml = article.image ? `
          <div class="blog-overview__search-result-image">
            <img src="${article.image.url}" alt="${article.title || ''}" loading="lazy">
          </div>
        ` : '';

        const excerpt = article.excerpt_or_content
          ? article.excerpt_or_content.replace(/<[^>]*>/g, '').substring(0, 80) + '...'
          : '';

        const date = article.published_at
          ? new Date(article.published_at).toLocaleDateString('de-DE', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })
          : '';

        li.innerHTML = `
          ${imageHtml}
          <div class="blog-overview__search-result-content">
            <p class="blog-overview__search-result-title">${article.title || ''}</p>
            ${excerpt ? `<p class="blog-overview__search-result-excerpt">${excerpt}</p>` : ''}
            ${date ? `<span class="blog-overview__search-result-meta">${date}</span>` : ''}
          </div>
        `;

        li.addEventListener('click', () => {
          window.location.href = article.url;
        });

        this.searchResults.appendChild(li);
      });
    }

    updateSelection() {
      const items = [...this.searchResults.querySelectorAll('[data-search-result]')];
      items.forEach((item, idx) => {
        item.setAttribute('aria-selected', idx === this.selectedIndex ? 'true' : 'false');
        if (idx === this.selectedIndex) {
          item.classList.add('blog-overview__search-result--selected');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('blog-overview__search-result--selected');
        }
      });

      if (this.selectedIndex < 0 || this.selectedIndex >= items.length) {
        this.selectedIndex = -1;
      }
    }

    closeDropdown() {
      this.searchDropdown.hidden = true;
      this.selectedIndex = -1;
      clearTimeout(this.searchTimeout);
    }

    fuzzyMatch(text, query) {
      if (!query) return true;
      const words = query.split(/\s+/);
      return words.every(word => {
        if (text.includes(word)) return true;
        // Allow 1 character difference (simple fuzzy)
        const textWords = text.split(/\s+/);
        return textWords.some(tw => {
          if (tw.length < 3 || word.length < 3) return tw.includes(word) || word.includes(tw);
          let matches = 0;
          const shorter = word.length < tw.length ? word : tw;
          const longer = word.length < tw.length ? tw : word;
          for (let i = 0; i < shorter.length; i++) {
            if (longer.includes(shorter[i])) matches++;
          }
          return matches / shorter.length >= 0.7;
        });
      });
    }

    applyFilters() {
      let visibleCount = 0;

      this.articles.forEach(article => {
        const tags = article.dataset.tags || '';
        const title = article.dataset.title || '';
        const content = article.dataset.content || '';
        const author = article.dataset.author || '';

        const matchesFilter = this.currentFilter === 'all' || tags.includes(this.currentFilter);
        const searchText = `${title} ${content} ${author} ${tags}`;
        const matchesSearch = this.fuzzyMatch(searchText, this.currentSearch);

        if (matchesFilter && matchesSearch) {
          article.hidden = false;
          visibleCount++;
        } else {
          article.hidden = true;
        }
      });

      if (this.resultsCount) this.resultsCount.textContent = visibleCount;
      if (this.noResults) this.noResults.hidden = visibleCount > 0;
      if (this.container) this.container.style.display = visibleCount > 0 ? '' : 'none';
    }

    applySort() {
      const sortBy = this.sortSelect.value;
      const sorted = [...this.articles].sort((a, b) => {
        switch (sortBy) {
          case 'newest': return parseInt(b.dataset.date) - parseInt(a.dataset.date);
          case 'oldest': return parseInt(a.dataset.date) - parseInt(b.dataset.date);
          case 'title_asc': return (a.dataset.title || '').localeCompare(b.dataset.title || '');
          case 'title_desc': return (b.dataset.title || '').localeCompare(a.dataset.title || '');
          default: return 0;
        }
      });

      sorted.forEach(article => this.container.appendChild(article));
    }

    disconnectedCallback() {
      // Event listeners are garbage collected with the element
    }
  }

  if (!customElements.get('blog-overview')) {
    customElements.define('blog-overview', BlogOverview);
  }
</script>

