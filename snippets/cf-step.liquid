{%- comment -%}
  Numbered process step ("So läuft's ab"). The number is generated via
  CSS counters, so steps renumber automatically when reordered.

  Accepts:
  - title: {String} step title
  - text: {String} step description
  - attrs: {String} optional block.shopify_attributes

  Usage:
  {% render 'cf-step', title: block.settings.title, text: block.settings.text, attrs: block.shopify_attributes %}
{%- endcomment -%}
<div class="cf-step cf-reveal" {{ attrs }}>
  <span class="cf-step__num" aria-hidden="true"></span>
  {%- if title != blank -%}
    <h3 class="cf-step__title">{{ title | escape }}</h3>
  {%- endif -%}
  {%- if text != blank -%}
    <p class="cf-step__text">{{ text }}</p>
  {%- endif -%}
</div>
