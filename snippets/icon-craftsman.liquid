{%- comment -%}
  Renders an inline SVG icon for the craftsman page sections.

  Accepts:
  - icon: {String} icon name (see case below)
  - class: {String} optional extra CSS class

  Usage:
  {% render 'icon-craftsman', icon: 'wrench' %}
{%- endcomment -%}
{%- liquid
  assign icon_class = 'cf-icon'
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}
