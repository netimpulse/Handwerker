{%- comment -%}
  FAQ accordion item (native details/summary, no JS required).

  Accepts:
  - question: {String} question text
  - answer: {String} answer (richtext)
  - open: {Boolean} render expanded (optional)
  - attrs: {String} optional block.shopify_attributes

  Usage:
  {% render 'cf-faq-item', question: block.settings.question, answer: block.settings.answer, attrs: block.shopify_attributes %}
{%- endcomment -%}
<details class="cf-faq__item" {% if open %}open{% endif %} {{ attrs }}>
  <summary>
    <span>{{ question | escape }}</span>
    <span class="cf-faq__icon" aria-hidden="true"></span>
  </summary>
  <div class="cf-faq__answer">{{ answer }}</div>
</details>
